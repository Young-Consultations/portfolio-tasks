#!/usr/bin/env bash
set -euo pipefail
set +x

: "${GH_TOKEN:?GH_TOKEN must be set}"
: "${API_ROOT:?API_ROOT must be set}"
: "${REPOSITORY:?REPOSITORY must be set}"
: "${BRANCH:?BRANCH must be set}"
: "${ISSUE_NUMBER:?ISSUE_NUMBER must be set}"
: "${GITHUB_OUTPUT:?GITHUB_OUTPUT must be set}"
: "${RUNNER_TEMP:?RUNNER_TEMP must be set}"

printf '%s\n' publication_failed > "$RUNNER_TEMP/failure-category"
auth=(-H "Authorization: Bearer $GH_TOKEN" -H 'Accept: application/vnd.github+json')
owner=${REPOSITORY%%/*}
existing=$(curl --fail --silent --show-error "${auth[@]}" \
  "$API_ROOT/repos/$REPOSITORY/pulls?state=all&head=$owner:$BRANCH")
jq -e 'type == "array"' <<< "$existing" >/dev/null

open_count=$(jq '[.[] | select(.state == "open")] | length' <<< "$existing")
if (( open_count > 1 )); then
  printf 'Refusing to publish: found %s open pull requests for %s.\n' \
    "$open_count" "$BRANCH" >&2
  exit 1
fi
if (( open_count == 1 )); then
  pull_request_url=$(jq -er '[.[] | select(.state == "open")][0].html_url' <<< "$existing")
  draft=$(jq -r '[.[] | select(.state == "open")][0].draft' <<< "$existing")
  case "$draft" in
    true) printf 'Reusing existing draft pull request: %s\n' "$pull_request_url" ;;
    false) printf 'Reusing existing non-draft pull request: %s\n' "$pull_request_url" ;;
    *) printf 'Refusing to publish: existing open pull request has invalid draft state.\n' >&2; exit 1 ;;
  esac
  printf 'url=%s\n' "$pull_request_url" >> "$GITHUB_OUTPUT"
  exit 0
fi

historical_count=$(jq 'length' <<< "$existing")
if (( historical_count > 0 )); then
  printf 'Refusing to publish: a closed or merged pull request already exists for %s.\n' \
    "$BRANCH" >&2
  exit 1
fi

remote="https://x-access-token:${GH_TOKEN}@github.com/${REPOSITORY}.git"
if git ls-remote --exit-code --heads "$remote" "refs/heads/$BRANCH" >/dev/null 2>&1; then
  printf 'Refusing to publish: remote branch %s exists without a pull request.\n' \
    "$BRANCH" >&2
  exit 1
else
  remote_status=$?
  if (( remote_status != 2 )); then
    printf 'Unable to determine whether remote branch %s exists.\n' "$BRANCH" >&2
    exit "$remote_status"
  fi
fi

git switch -c "$BRANCH"
git config user.name 'portfolio-codex[bot]'
git config user.email 'portfolio-codex[bot]@users.noreply.github.com'
git add --all
git commit -m "Implement approved portfolio task #$ISSUE_NUMBER"
git push "$remote" "HEAD:refs/heads/$BRANCH"
request=$(jq -n --arg title "Codex: implement portfolio task #$ISSUE_NUMBER" \
  --arg head "$BRANCH" \
  '{title:$title,head:$head,base:"main",body:"Automated implementation.",draft:true}')
response=$(curl --fail --silent --show-error "${auth[@]}" -X POST \
  "$API_ROOT/repos/$REPOSITORY/pulls" -d "$request")
jq -e '.draft == true and .state == "open" and (.html_url | type == "string")' \
  <<< "$response" >/dev/null
printf 'url=%s\n' "$(jq -r .html_url <<< "$response")" >> "$GITHUB_OUTPUT"
