#!/usr/bin/env bash
set -euo pipefail
set +x

: "${GH_TOKEN:?GH_TOKEN must be set}"
: "${REPOSITORY:?REPOSITORY must be set}"
: "${BRANCH:?BRANCH must be set}"
: "${BASE_REVISION:?BASE_REVISION must be set}"
: "${TASK_WORKTREE:?TASK_WORKTREE must be set}"
REQUIRE_EXISTING_BRANCH="${REQUIRE_EXISTING_BRANCH:-false}"
[[ "$REQUIRE_EXISTING_BRANCH" == true || "$REQUIRE_EXISTING_BRANCH" == false ]]

remote="https://x-access-token:${GH_TOKEN}@github.com/${REPOSITORY}.git"
if [[ -e "$TASK_WORKTREE" ]]; then
  printf 'Task worktree path already exists: %s\n' "$TASK_WORKTREE" >&2
  exit 1
fi

if git ls-remote --exit-code --heads "$remote" "refs/heads/$BRANCH" >/dev/null 2>&1; then
  git fetch "$remote" \
    "refs/heads/$BRANCH:refs/remotes/origin/$BRANCH"
  git worktree add --force -B "$BRANCH" "$TASK_WORKTREE" "origin/$BRANCH"
  git -C "$TASK_WORKTREE" branch --set-upstream-to="origin/$BRANCH" "$BRANCH"
  printf 'Prepared existing task branch %s.\n' "$BRANCH"
else
  remote_status=$?
  if (( remote_status != 2 )); then
    printf 'Unable to determine whether remote branch %s exists.\n' "$BRANCH" >&2
    exit "$remote_status"
  fi
  if [[ "$REQUIRE_EXISTING_BRANCH" == true ]]; then
    printf 'Required remote branch %s does not exist.\n' "$BRANCH" >&2
    exit 1
  fi
  git worktree add -b "$BRANCH" "$TASK_WORKTREE" "$BASE_REVISION"
  printf 'Prepared new task branch %s from %s.\n' "$BRANCH" "$BASE_REVISION"
fi
