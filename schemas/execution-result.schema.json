{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Young-Consultations/.github/schemas/execution-result.schema.json",
  "title": "Canonical execution result",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "correlation_id", "execution_status", "target_repository", "branch_name", "pull_request_url", "workflow_url", "validation_result", "test_result", "failure_category", "failure_message", "started_at", "completed_at"],
  "properties": {
    "contract_version": {"const": "ai-sdlc-execution-result/v1"},
    "correlation_id": {"type": "string", "minLength": 1},
    "execution_status": {"enum": ["succeeded", "failed"]},
    "target_repository": {"const": "Young-Consultations/portfolio-tasks"},
    "branch_name": {"type": ["string", "null"]},
    "pull_request_url": {"type": ["string", "null"], "format": "uri"},
    "workflow_url": {"type": "string", "format": "uri"},
    "validation_result": {"enum": ["passed", "failed", "not_run"]},
    "test_result": {"enum": ["passed", "failed", "not_run"]},
    "failure_category": {"enum": [null, "invalid_input", "authorization_failed", "codex_failed", "no_changes", "validation_failed", "tests_failed", "publication_failed", "reporting_failed", "internal_error"]},
    "failure_message": {"type": ["string", "null"], "maxLength": 500},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
