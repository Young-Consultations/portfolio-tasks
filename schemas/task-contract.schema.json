{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Young-Consultations/.github/task-contract.schema.json",
  "title": "AI SDLC task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "source", "status", "executor", "priority", "project", "parallel_safe", "target_repository", "task_type", "dependencies", "instructions"],
  "properties": {
    "schema_version": { "const": "ai-sdlc-contract/v1" },
    "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*@[1-9][0-9]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue_number"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "issue_number": { "type": "integer", "minimum": 1 }
      }
    },
    "status": { "enum": ["proposed", "approved", "queued", "running", "draft-pr", "blocked", "done"] },
    "executor": { "enum": ["codex", "human", "chatgpt-planning"] },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "project": { "type": "string", "minLength": 1 },
    "parallel_safe": { "type": "boolean" },
    "target_repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "task_type": { "enum": ["bug-fix", "feature", "refactor", "ci-cd", "documentation", "security", "repository-governance", "automation", "investigation"] },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(#[1-9][0-9]*|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*)$" }
    },
    "instructions": { "type": "string", "minLength": 1 }
  },
  "const": { "schema_version": "ai-sdlc-contract/v1" },
  "required_top_level": ["correlation_id", "dependencies", "executor", "instructions", "parallel_safe", "priority", "project", "schema_version", "source", "status", "target_repository", "task_type"],
  "enum": {
    "status": ["proposed", "approved", "queued", "running", "draft-pr", "blocked", "done"],
    "executor": ["codex", "human", "chatgpt-planning"],
    "priority": ["P0", "P1", "P2", "P3"],
    "task_type": ["bug-fix", "feature", "refactor", "ci-cd", "documentation", "security", "repository-governance", "automation", "investigation"]
  }
}
