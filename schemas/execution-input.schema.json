{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Young-Consultations/.github/schemas/execution-input.schema.json",
  "title": "Canonical Codex execution input",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "correlation_id", "source_issue", "target_repository", "executor", "draft_pr_only", "instructions"],
  "properties": {
    "contract_version": {"const": "ai-sdlc-execution-input/v1"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_issue": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "number"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "target_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "executor": {"const": "codex"},
    "draft_pr_only": {"const": true},
    "instructions": {"type": "string", "minLength": 1, "maxLength": 100000}
  }
}
